artifacts/in_context_response_query_rq0/**/validation_episode_metrics.csv
artifacts/in_context_response_query_rq0/**/conditional_collisions.csv
# Superseded Wave-as-Prompt development outputs: per-seed re-selection was
# replaced by one frozen selection, and stride-4 did not change local spacing.
artifacts/wave_as_prompt_pfto/m0_latent_prior_seed20260924/
artifacts/wave_as_prompt_pfto/m0_continuous_query_dense_stride4/
# PBNO development sweeps are summarized in the M2 report; keep only the
# frozen cross-seed summary under version control.
artifacts/pbno_q2_rank96_efficiency/
artifacts/pbno_q2_efficiency_formal/*_seed*/
# Superseded PBNO M3 development grids; v3 is the frozen formal result.
artifacts/pbno_posterior_memory_formal/
artifacts/pbno_posterior_kernel_formal/
artifacts/pbno_posterior_kernel_formal_v2/
# Posterior-composer exploratory checkpoints and per-system formal arrays stay local;
# only the frozen summary table/figure is versioned.
artifacts/pbno_posterior_composer_m0_dev*/
artifacts/pbno_posterior_composer_m0_formal/
# Heterogeneous functional-operator development runs; only the frozen summary
# directory is versioned.
artifacts/heterogeneous_prompt_headroom_m0_dev*/
artifacts/functional_evidence_operator_m0_dev*/
artifacts/functional_prompt_reranker_m0_dev*/
artifacts/functional_response_metric_m0_dev*/
artifacts/functional_response_metric_m1_multilayout_dev*/
artifacts/wave_neural_field_autodecoder_m0_ocean_dev*/
artifacts/wave_neural_field_prompt_encoder_m0_ocean_dev*/
# Uncertainty-proximal-prior checkpoints and per-system arrays stay local;
# only pbno_uncertainty_proximal_prior_m0_summary is versioned.
artifacts/pbno_uncertainty_proximal_prior_m0_dev*/
artifacts/pbno_uncertainty_proximal_prior_m0_openfwi*/
artifacts/pbno_uncertainty_proximal_prior_m0_deepwave*/
artifacts/pbno_uncertainty_proximal_prior_m0_ocean*/
# Query-metric and active-policy development checkpoints remain local.  The
# frozen cross-seed sequential summary is versioned separately.
artifacts/pbno_query_conditioned_metric_m0_*/
artifacts/active_wave_query_policy_m0_*/
# Learned utility checkpoints remain local; summaries and frozen schedules are versioned.
artifacts/continuous_acquisition_utility_m*/**/best.pt
# Development-only utility iterations; final M1/M2 summaries are kept separately.
artifacts/continuous_acquisition_utility_m0/
artifacts/acquisition_baselines_m1_utility_dev/
artifacts/continuous_acquisition_utility_m2_coordinate_holdout/schedules.json
# Per-system stable-baseline rows are local; summaries and selection grids are versioned.
