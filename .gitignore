# Large datasets and training artifacts are external by design.
data/*
!data/README.md
artifacts/**/*.pt
artifacts/**/*.pth
artifacts/**/*.ckpt
artifacts/**/*.npz
artifacts/**/*.npy
# Per-case matrices and failed exploratory contrastive runs remain local; the
# frozen JSON summaries and paper figures are versioned.
artifacts/**/*_records.csv
artifacts/**/*_similarity.csv
artifacts/wave_operator_representation/m2_contrastive/
artifacts/wave_operator_representation/m2_contrastive_seed*/
artifacts/wavebench_representation_m1/pilot*/
artifacts/cross_domain_response_query/**/*_system_metrics.csv
artifacts/cross_domain_response_query/data/*_smoke_v1.manifest.json
artifacts/cross_domain_response_query/smoke_m1/
